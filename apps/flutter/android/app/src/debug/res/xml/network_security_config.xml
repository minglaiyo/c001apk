<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug only: allow cleartext and user-installed certificates so
         traffic can be inspected with a proxy. This file is merged only
         into debug builds; release uses the strict main config. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
